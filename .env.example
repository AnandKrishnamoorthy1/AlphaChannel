# AlphaChannel 2026 Slack Hackathon configuration

# Required: Slack Socket Mode
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-socket-mode-token

# Required: Gemini orchestration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TEMPERATURE=0.15
GEMINI_TOP_P=0.8
GEMINI_MAX_TOOL_CALLS=4

# Required: SEC EDGAR fair-access identity
EDGAR_IDENTITY=AlphaChannel your-email@example.com
SEC_EDGAR_USER_AGENT=AlphaChannel your-email@example.com
SEC_EDGAR_BACKEND=raw
SEC_EDGARTOOLS_TIMEOUT_SECONDS=5
SEC_EDGAR_HTTP_TIMEOUT_SECONDS=6

# Yahoo Finance MCP deadlines and cache
YFINANCE_TIMEOUT_SECONDS=12
YFINANCE_FUNDAMENTALS_TIMEOUT_SECONDS=30
YFINANCE_CACHE_TTL_SECONDS=180
YAHOO_FINANCE_MCP_CONNECT_TIMEOUT_SECONDS=15
YAHOO_FINANCE_MCP_TIMEOUT_SECONDS=20

# AlphaChannel MCP and intent controls
ALPHACHANNEL_MCP_TOOL_TIMEOUT_SECONDS=35
ALPHACHANNEL_SEC_TOOL_TIMEOUT_SECONDS=30
ALPHACHANNEL_INTENT_CONFIDENCE_THRESHOLD=0.70
ALPHACHANNEL_RTS_LIMIT=12
ALPHACHANNEL_REPOSITORY_ROOT=C:\AI_Agents\AlphaChannel

# Portfolio persistence and market-data refresh
ALPHACHANNEL_PORTFOLIO_DB_PATH=data/portfolio.db
PORTFOLIO_MARKET_DATA_TIMEOUT_SECONDS=10

# Compliance archive. Prefer a channel ID in production.
ALPHACHANNEL_AUDIT_CHANNEL_ID=C0123456789

# Runtime logging
LOG_LEVEL=INFO
